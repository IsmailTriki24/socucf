# Copier en .env puis renseigner. Ne jamais versionner .env.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
PUBLIC_HOST=soc-ucf.example.org
# Si le port public n'est pas 443 : PUBLIC_PORT_SUFFIX=:8443 et HTTPS_PORT=8443
PUBLIC_PORT_SUFFIX=
HTTP_PORT=80
HTTPS_PORT=443
# SSO OpenID Connect (optionnel : laisser vide pour n'utiliser que les comptes locaux)
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
